#!/bin/sh
# Blocks pushes whose destination ref is a protected branch (main, develop) — see AGENTS.md.
# Checks the remote ref, not the current branch, so `git push origin HEAD:main` is caught too.
#
# Emergency override: ALLOW_PROTECTED=1 git push origin main
#
# Activated by: git config core.hooksPath .githooks
#
# git feeds pre-push one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

PROTECTED="refs/heads/main refs/heads/develop"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  case " $PROTECTED " in
    *" $remote_ref "*)
      if [ "${ALLOW_PROTECTED:-0}" = "1" ]; then
        echo "[pre-push] WARNING: pushing to protected '${remote_ref#refs/heads/}' (ALLOW_PROTECTED=1)." >&2
        continue
      fi
      case "$local_ref" in
        "(delete)") action="delete" ;;
        *)          action="update" ;;
      esac
      echo "[pre-push] BLOCKED: $action push to protected branch '${remote_ref#refs/heads/}' is not allowed." >&2
      echo "           Push a feature branch and open a pull request instead:" >&2
      echo "             git switch -c feat/<short-name> && git push -u origin HEAD" >&2
      echo "             gh pr create --base ${remote_ref#refs/heads/} --fill" >&2
      echo "           See AGENTS.md." >&2
      status=1
      ;;
  esac
done

exit $status
