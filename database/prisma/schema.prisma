// PSX Stock Scraper — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model Stock {
  id          String       @id @default(uuid())
  symbol      String       @unique
  companyName String?      @map("company_name")
  sector      String?
  // Where the classification came from and when it was last read (migration 0023). Null date means
  // "not recorded yet" — never inferred from `updatedAt`, which moves for prices too.
  sectorSource    String?   @map("sector_source")
  sectorUpdatedAt DateTime? @map("sector_updated_at") @db.Timestamptz(6)
  // Company logo (the SYMBOL column's icon), from Sarmaaya's ALLSHR constituents board. Null for
  // symbols it publishes no logo for (ETFs, preference shares, rights) — the frontend shows a
  // letter avatar then, never a broken image.
  logoUrl     String?      @map("logo_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  prices      StockPrice[]
  dividends   Dividend[]
  corporateActions CorporateAction[]
  announcements Announcement[]
  alerts Alert[]
  financials  Financial[]
  ratios      Ratio[]
  incomeStatements IncomeStatement[]
  syncLogs    SyncLog[]
  // Membership of a published index (KSE-100 today). A join rather than a column: the exchange
  // publishes each index's own member list, and the dashboard's first page is driven by it.
  constituents IndexConstituent[]
  // The same members' *live* contribution to their index, refreshed through the session.
  contributions IndexContribution[]
  // Editorial company profile (the stock page's "Company Description" section). Null for almost
  // every symbol: this is written by hand, not scraped — see the 0020 migration's header.
  profile     CompanyProfile?

  @@index([companyName])
  @@map("stocks")
}

model StockPrice {
  id            String   @id @default(uuid())
  stockId       String   @map("stock_id")
  currentPrice  Decimal? @map("current_price") @db.Decimal(18, 4)
  change        Decimal? @db.Decimal(18, 4)
  changePercent Decimal? @map("change_percent") @db.Decimal(10, 4)
  volume        BigInt?
  high          Decimal? @db.Decimal(18, 4)
  low           Decimal? @db.Decimal(18, 4)
  open          Decimal? @db.Decimal(18, 4)
  close         Decimal? @db.Decimal(18, 4)
  marketCap     Decimal? @map("market_cap") @db.Decimal(24, 2)
  // 52-week range as PSX publishes it on the company page ("52-WEEK RANGE"). Written by the
  // company-page sync; the per-minute quote poll never touches it (it has no such field).
  week52High    Decimal? @map("week52_high") @db.Decimal(18, 4)
  week52Low     Decimal? @map("week52_low") @db.Decimal(18, 4)
  lastTradeDate DateTime? @map("last_trade_date")
  createdAt     DateTime @default(now()) @map("created_at")

  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, lastTradeDate])
  @@index([stockId, lastTradeDate(sort: Desc)])
  // The data-status endpoint asks for the newest session across the whole table; without this the
  // answer is a sequential scan (see migration 0021).
  @@index([lastTradeDate(sort: Desc)])
  @@map("stock_prices")
}

model Dividend {
  id               String    @id @default(uuid())
  stockId          String    @map("stock_id")
  announcementDate DateTime? @map("announcement_date")
  /// First session trading without the entitlement. The source publishes none today, so it is
  /// nullable and rendered as an em dash — never inferred from the book-closure date.
  exDate     DateTime? @map("ex_date") @db.Date
  bookClosure      DateTime? @map("book_closure")
  paymentDate      DateTime? @map("payment_date")
  dividend         Decimal?  @db.Decimal(18, 4)
  createdAt        DateTime  @default(now()) @map("created_at")

  stock            Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, announcementDate])
  @@map("dividends")
}

model Financial {
  id              String   @id @default(uuid())
  stockId         String   @map("stock_id")
  year            Int
  quarter         Int?
  eps             Decimal? @db.Decimal(18, 4)
  sales           Decimal? @db.Decimal(24, 2)
  profitAfterTax  Decimal? @map("profit_after_tax") @db.Decimal(24, 2)
  assets          Decimal? @db.Decimal(24, 2)
  liabilities     Decimal? @db.Decimal(24, 2)
  equity          Decimal? @db.Decimal(24, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  stock           Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, year, quarter])
  @@map("financials")
}

/// One income-statement line item per period per stock. The source's own statement — a bank's rows
/// are different from an industrial's — so it is stored as ordered rows rather than a fixed set of
/// columns: `position` preserves the statement's line order and the UI renders whatever rows exist.
model IncomeStatement {
  id          String   @id @default(uuid())
  stockId     String   @map("stock_id")
  /// Column key: "TTM" for the trailing-twelve-month reading, or a fiscal year like "2025".
  periodKey   String   @map("period_key")
  /// "ANN" (fiscal year) or "LTM" (trailing twelve months).
  periodicity String
  /// The source's own metric code (FF_SALES, FF_NET_INC, …).
  metricCode  String   @map("metric_code")
  /// Display name as the source prints it ("Revenue", "Tax Rate (%)", "Basic EPS", …).
  metricName  String   @map("metric_name")
  value       Decimal? @db.Decimal(24, 4)
  /// Line order within the statement, so the UI renders the source's own order.
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")

  stock       Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, periodKey, metricCode])
  @@index([stockId, periodKey])
  @@map("income_statements")
}

model Ratio {
  id            String   @id @default(uuid())
  stockId       String   @map("stock_id")
  peRatio       Decimal? @map("pe_ratio") @db.Decimal(12, 4)
  pbRatio       Decimal? @map("pb_ratio") @db.Decimal(12, 4)
  roe           Decimal? @db.Decimal(12, 4)
  roa           Decimal? @db.Decimal(12, 4)
  dividendYield Decimal? @map("dividend_yield") @db.Decimal(12, 4)
  /// Book value per share (equity / shares outstanding), as the source publishes it for the newest
  /// period it reports. Null means "the source published none" and renders as a dash -- never 0 and
  /// never carried over from an earlier sync (#79). Migration 0011.
  bookValue     Decimal? @map("book_value") @db.Decimal(12, 4)
  beta          Decimal? @db.Decimal(12, 4)
  /// Earnings per share, as the source's own snapshot publishes it (`FF_EPS` -- the LTM figure its
  /// stock page shows). Null means "the source published none" and renders as a dash -- never 0 and
  /// never derived from price / (price-to-earnings). Migration 0012.
  eps           Decimal? @db.Decimal(12, 4)
  /// Net profit margin, as the source's details payload publishes it (`FF_NET_MGN`). Null = the
  /// source published none, renders as a dash. Migration 0015.
  netProfitMargin  Decimal? @map("net_profit_margin") @db.Decimal(12, 4)
  /// Free-float share count, as the source's details payload publishes it (`FF_SHS_FLOAT`).
  /// A count (hundreds of millions), so a wider scale than the ratio columns. Migration 0015.
  freeFloatShares  Decimal? @map("free_float_shares") @db.Decimal(24, 2)
  /// Free float as a percentage of shares outstanding (`FF_SHS_FLOAT_PERCENT`). Migration 0015.
  freeFloatPercent Decimal? @map("free_float_percent") @db.Decimal(12, 4)
  /// Dividend per share -- the newest announced per-share dividend from the dividends endpoint.
  /// Null = no dividend on record, renders as a dash. Migration 0015.
  dps              Decimal? @db.Decimal(12, 4)
  /// Dividend payout ratio, from the ratio series ("Dividend Payout Ratio"). Migration 0015.
  payoutRatio      Decimal? @map("payout_ratio") @db.Decimal(12, 4)
  /// Return on average invested capital (%), from the ratio series. Migration 0015.
  roic             Decimal? @db.Decimal(12, 4)
  /// Debt to equity (%), from the ratio series ("Debt to Equity (%)"). Migration 0015.
  debtToEquity     Decimal? @map("debt_to_equity") @db.Decimal(12, 4)
  /// Current ratio (x), from the ratio series ("Current Ratio (x)"). Banks publish none -- null. Migration 0015.
  currentRatio     Decimal? @map("current_ratio") @db.Decimal(12, 4)
  /// Net sales year-over-year growth (%), from the ratio series ("Net Sales YoY Growth (%)"). Migration 0015.
  revenueGrowth    Decimal? @map("revenue_growth") @db.Decimal(12, 4)
  /// Basic EPS year-over-year growth (%), from the ratio series ("EPS Basic YoY Growth (%)"). Migration 0015.
  epsGrowth        Decimal? @map("eps_growth") @db.Decimal(12, 4)
  createdAt     DateTime @default(now()) @map("created_at")

  stock         Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, createdAt(sort: Desc)])
  @@map("ratios")
}

model IndexValue {
  id        String   @id @default(uuid())
  indexId   String   @map("index_id")
  tradeDate DateTime @map("trade_date")
  value     Decimal  @db.Decimal(18, 4)
  open      Decimal? @db.Decimal(18, 4)
  volume    BigInt?
  /// When the reading behind `value` was taken. Null, or a time before the session's close, means
  /// this row's value is not known to be the session's close — see the note in migration 0009.
  valueAt   DateTime? @map("value_at")
  createdAt DateTime @default(now()) @map("created_at")

  index     MarketIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, tradeDate])
  @@index([indexId, tradeDate(sort: Desc)])
  @@map("index_values")
}

/// A market index (KSE100, …). Deliberately separate from `stocks`: an index has no
/// company page, sector, ratios or dividends, and its upstream is the DPS time-series
/// endpoint rather than a company page. `liveValue`/`liveAt` hold the newest intraday
/// reading, which the summary prefers over the last daily close while a session is open.
model MarketIndex {
  id          String       @id @default(uuid())
  symbol      String       @unique
  name        String
  liveValue   Decimal?     @map("live_value") @db.Decimal(18, 4)
  liveAt      DateTime?    @map("live_at")
  /// Point and percent change as published by the exchange, against its official previous close.
  liveChange        Decimal?     @map("live_change") @db.Decimal(18, 4)
  liveChangePercent Decimal?     @map("live_change_percent") @db.Decimal(10, 4)
  lastSyncedAt DateTime?   @map("last_synced_at")
  /// 52-week high/low and market cap as Sarmaaya's board publishes them, for the index page's
  /// SEO meta description. Nullable: a source that publishes no figure reads as unknown, never 0.
  week52High  Decimal?     @map("week52_high") @db.Decimal(18, 4)
  week52Low   Decimal?     @map("week52_low") @db.Decimal(18, 4)
  marketCap   Decimal?     @map("market_cap") @db.Decimal(24, 2)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  values      IndexValue[]
  /// The index's published member list, newest pass wins.
  constituents IndexConstituent[]
  /// Its members' latest contribution to this index, one row per constituent, overwritten on
  /// every pass rather than appended (the board shows today's contribution, not a history).
  contributions IndexContribution[]

  @@map("market_indices")
}

/// One company's membership of one published index.
///
/// Written by `kse100Membership.service` from the exchange's own member list; the row set is
/// *replaced* on each pass (a symbol that leaves the index must leave the group, or the
/// dashboard keeps showing it on page one forever). `position` keeps the source's own order for
/// the day a reader needs it; the list itself is presented through the stocks list query.
model IndexConstituent {
  id        String   @id @default(uuid())
  indexId   String   @map("index_id")
  stockId   String   @map("stock_id")
  /// The name the source prints for this company, when it prints one.
  name      String?
  /// Position in the source's list, 1-based. Null when the source states no order.
  position  Int?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  index MarketIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)
  stock Stock       @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([indexId, stockId])
  @@index([stockId])
  @@map("index_constituents")
}

/// One constituent's **live** contribution to one index, as the source publishes it.
///
/// `points` is the exchange's own contribution figure — how much this stock moved the index's level
/// — and `weight` its share of the index. Both are *readings*, not history: the row is overwritten
/// on every pass (every couple of minutes through the session), because the dashboard shows what the
/// stock is contributing now, and appending would put ~500 rows in the table every tick for no one.
///
/// `level` is the constituent's own last price in the same payload, kept so a stored contribution can
/// be checked against the price it was measured at rather than trusted on its own.
///
/// Absence is meaningful and is stored as NULL, never 0: the source carries constituents it has not
/// published a reading for, and a `0.00` there would read as "this stock moved the index by nothing"
/// when the truth is "nobody said". See the `isPublished` guard in the service.
model IndexContribution {
  id         String   @id @default(uuid())
  indexId    String   @map("index_id")
  stockId    String   @map("stock_id")
  /// Index points this stock contributed, signed. Null when the source published no reading.
  points     Decimal? @db.Decimal(20, 4)
  /// Share of the index, in percent (KTML: 0.23). Null when the source published no reading.
  weight     Decimal? @db.Decimal(12, 4)
  /// The constituent's own price in the same reading, for reconciliation.
  level      Decimal? @db.Decimal(20, 4)
  /// When the reading was taken (our clock, not the source's — it publishes none per row).
  capturedAt DateTime @map("captured_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  index MarketIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)
  stock Stock       @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([indexId, stockId])
  @@index([stockId])
  @@map("index_contributions")
}

model SyncLog {
  id           String     @id @default(uuid())
  stockId      String?    @map("stock_id")
  symbol       String?
  status       SyncStatus @default(PENDING)
  startedAt    DateTime   @default(now()) @map("started_at")
  completedAt  DateTime?  @map("completed_at")
  durationMs   Int?       @map("duration_ms")
  errorMessage String?    @map("error_message")

  stock        Stock?     @relation(fields: [stockId], references: [id], onDelete: SetNull)

  @@index([stockId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([symbol, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@map("sync_logs")
}

/// A symbol removed on purpose. Registration paths consult this table so a stale listing page, a
/// queued sync job or a discovery pass cannot put it back; adding the symbol by hand clears it.
model DeletedSymbol {
  symbol    String   @id
  reason    String?
  deletedAt DateTime @default(now()) @map("deleted_at")

  @@map("deleted_symbols")
}

/// PSX's published market holidays (issue: the holiday hole). `partial` marks a closure PSX
/// qualifies as one community's - not a market-wide closure, so it never blocks a session.
model MarketHoliday {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  name      String
  days      Int?
  partial   Boolean  @default(false)
  source    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("market_holidays")
}

/// Editorial company profile — the "Company Description" section on a stock page.
///
/// Nothing here is scraped. No source this project integrates publishes a description, CEO,
/// website, phone or product list (probed 2026-10-16, issue #180), so every content column is
/// human-supplied and nullable, and a row exists only once someone has written something. A
/// stock with no row renders no section at all — absence is the default state, not an edge case,
/// so the read path must treat "no profile" as ordinary rather than as missing data.
model CompanyProfile {
id          String   @id @default(uuid())
stockId     String   @unique @map("stock_id")
/// Short prose description of the business — the one field worth having on its own.
description String?
/// Registered / head-office address, as the company itself states it.
headOffice  String?  @map("head_office")
phone       String?
/// The company's own site. Stored as written; the UI is responsible for making it a safe link.
website     String?
ceo         String?
/// Where this content came from, so a reader can weigh it. Free text (an annual report, a
/// company site, the submitter) rather than a URL contract.
sourceNote  String?  @map("source_note")
createdAt   DateTime @default(now()) @map("created_at")
updatedAt   DateTime @updatedAt @map("updated_at")

stock       Stock            @relation(fields: [stockId], references: [id], onDelete: Cascade)
products    CompanyProduct[]

@@map("company_profiles")
}

/// One product a company makes, with its own image and that image's provenance.
model CompanyProduct {
id           String   @id @default(uuid())
profileId    String   @map("profile_id")
name         String
summary      String?
/// Path served by this app (e.g. `/products/luck-cement-plant.jpg`), not a remote URL. A
/// product image that silently 404s, or vanishes with someone else's CDN, is worse than no
/// image at all — these are the only images on the page we cannot re-derive from a source.
imagePath    String?  @map("image_path")
/// Required whenever `imagePath` is set: where the image came from and under what licence.
/// Enforced by the content script and its test, which Prisma's schema cannot express.
imageSource  String?  @map("image_source")
imageLicence String?  @map("image_licence")
/// Order within the section, so the writer controls the reading order.
position     Int
createdAt    DateTime @default(now()) @map("created_at")

profile      CompanyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

@@index([profileId, position])
@@map("company_products")
}

/// A split, bonus, rights issue or cash dividend that changes the meaning of the stored prices.
///
/// `type` is a free string on purpose: the exchange's notice vocabulary is broader than this model
/// (`SPLIT`, `BONUS`, `RIGHTS`, `CASH_DIVIDEND`, …) and an unrecognised action is still a *fact*
/// about the stock. Dropping it would silently leave the history unadjusted.
model CorporateAction {
  id         String    @id @default(uuid())
  stockId    String    @map("stock_id")
  type       String
  /// The first session the shares trade without the entitlement. Adjustments apply *before* this date.
  exDate     DateTime? @map("ex_date") @db.Date
  recordDate DateTime? @map("record_date") @db.Date
  /// SPLIT/BONUS are expressed as old:new shares — a 2-for-1 split is 1:2, a 1-for-10 bonus is 10:11.
  ratioFrom  Decimal?  @map("ratio_from") @db.Decimal(18, 6)
  ratioTo    Decimal?  @map("ratio_to") @db.Decimal(18, 6)
  /// Cash amount per share, in PKR, for CASH_DIVIDEND (and the consideration of a RIGHTS issue).
  amount     Decimal?  @db.Decimal(24, 4)
  /// `confirmed` once the exchange has published it; anything else (rumour, proposed) is kept but
  /// not applied to prices.
  status     String    @default("confirmed")
  sourceUrl  String?   @map("source_url")
  fetchedAt  DateTime  @default(now()) @map("fetched_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, type, exDate])
  @@index([stockId, exDate])
  @@map("corporate_actions")
}

/// An official notice: the exchange's or the company's own announcement.
///
/// `stock_id` is nullable because a notice can be market-wide (a holiday, a rule change) and forcing
/// a stock would either drop those rows or attach them to something arbitrary.
model Announcement {
  id          String    @id @default(uuid())
  stockId     String?   @map("stock_id")
  category    String
  title       String
  summary     String?
  body        String?
  publishedAt DateTime  @map("published_at")
  source      String
  sourceUrl   String    @map("source_url")
  /// Stable identity of the notice at its source (its own id, or a hash of title+date+symbol).
  /// Unique with `source` so re-running the ingestor never stores the same notice twice.
  dedupeKey   String    @map("dedupe_key")
  fetchedAt   DateTime  @default(now()) @map("fetched_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  stock Stock? @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([source, dedupeKey])
  @@index([publishedAt])
  @@index([stockId, publishedAt])
  @@index([category])
  @@map("announcements")
}

/// A data condition the reader asked to be told about — never a recommendation.
///
/// Ownership is a device token: the app has no accounts, and a token is the smallest thing that can
/// survive a page reload. It is an opaque string the browser generates and keeps in localStorage, and
/// it maps to a real user id later without touching these rows.
model Alert {
  id              String    @id @default(uuid())
  ownerToken      String    @map("owner_token")
  stockId         String    @map("stock_id")
  /// PRICE_ABOVE | PRICE_BELOW | PCT_MOVE | RSI_ABOVE | RSI_BELOW | CROSS_ABOVE_SMA | CROSS_BELOW_SMA
  kind            String
  threshold       Decimal?  @db.Decimal(18, 4)
  /// A fired alert stays quiet for this long. Without it a price sitting on the line would fire
  /// every single poll.
  cooldownMinutes Int       @default(60) @map("cooldown_minutes")
  paused          Boolean   @default(false)
  lastFiredAt     DateTime? @map("last_fired_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  stock  Stock        @relation(fields: [stockId], references: [id], onDelete: Cascade)
  events AlertEvent[]

  @@index([ownerToken])
  @@index([stockId])
  @@map("alerts")
}

/// One firing. Kept even when delivery fails, with the failure recorded — an alert that silently
/// never arrived is worse than one that is late.
model AlertEvent {
  id             String   @id @default(uuid())
  alertId        String   @map("alert_id")
  firedAt        DateTime @default(now()) @map("fired_at")
  value          Decimal? @db.Decimal(18, 4)
  message        String
  channel        String   @default("in-app")
  deliveryStatus String   @default("stored") @map("delivery_status")
  error          String?

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, firedAt])
  @@map("alert_events")
}

/// Last known state of one external data source (#214). Written by the scrape runner per provider
/// outcome; `source` matches the ids in backend/src/data-sources.ts.
model SourceHealth {
  source        String    @id
  lastSuccessAt DateTime? @map("last_success_at")
  lastFailureAt DateTime? @map("last_failure_at")
  lastError     String?   @map("last_error")
  successCount  Int       @default(0) @map("success_count")
  failureCount  Int       @default(0) @map("failure_count")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("source_health")
}
