# ---- Shared / Compose ----
POSTGRES_USER=psx
POSTGRES_PASSWORD=psx_password
POSTGRES_DB=psx
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- Backend ----
DATABASE_URL=postgresql://psx:psx_password@postgres:5432/psx?schema=public
REDIS_URL=redis://redis:6379
PORT=4000
# Host port the API is published on (base compose: ${API_HOST_PORT:-4000}). This repo's
# README uses 4001 locally to avoid clashing with another local service; production uses
# 4000 so the public URL is http://<host>:4000/api/v1.
API_HOST_PORT=4000
SCRAPER_TIMEOUT=30000
SCRAPER_CONCURRENCY=2
SCRAPER_DELAY_MS=500
CRON_EXPRESSION=0 * * * *
# Live-quote poll (price / change% for every tracked symbol, no browser). Runs independently
# of CRON_EXPRESSION: prices move by the minute, ratios/dividends/financials do not.
# One tick a minute: a tick is the market-wide ticker (one request for the whole board) plus a
# capped per-symbol fan-out for what the ticker omits — seconds, and no browser. The DPS leg is
# one request per symbol (the load behind the #27 refusal) and keeps its own slower interval.
QUOTE_POLL_CRON=*/1 * * * *
QUOTE_POLL_CONCURRENCY=5
QUOTE_POLL_TIMEOUT_MS=10000
# The DPS fan-out is one request per symbol, so it runs at its own slower interval even when the
# poll ticks every minute; between those ticks the market-wide ticker and the capped per-symbol
# leg serve the board. 300000 = a DPS pass every 5 minutes.
QUOTE_POLL_DPS_MIN_INTERVAL_MS=300000
# Ceiling on the per-symbol sarmaaya leg *per tick* — what the ticker does not carry: ETFs,
# preference shares, renamed tickers (~35 symbols). That host throttles a whole-tail request every
# minute (`http=429`), so the tail is walked a slice per tick and wraps; 12 covers all of it every
# few minutes.
SARMAYA_QUOTE_MAX_SYMBOLS=12
# Only poll around the PSX session (Mon-Fri 09:25-15:35 PKT). false = around the clock.
# What that costs: every 5 minutes is 288 ticks/day; at `*/1 * * * *` it is 1,440 ticks/day,
# and a tick asks once per tracked symbol (~25) — about 36,000 requests a day against a session
# that closed hours earlier. `QUOTE_POLL_MARKET_HOURS_ONLY=true` keeps the poll silent while
# the market is shut; a source that refuses us now also trips a cooldown (see docs/architecture.md).
QUOTE_POLL_MARKET_HOURS_ONLY=true
# Universe worker: walks every PSX-listed security (one at a time, market hours only) and adds
# symbols this database does not have yet. A release ships code, not data — an environment that
# has never set this will keep exactly the symbols it already has, with nothing in the logs
# saying why. The app now logs `config.feature_setting_absent` at start-up for these.
UNIVERSE_ENABLED=false
UNIVERSE_PASS_CRON=*/3 * * * *
UNIVERSE_PACING_MS=1500
UNIVERSE_MAX_QUOTE_AGE_DAYS=4
UNIVERSE_MAX_VOLUME_MULTIPLE=100
UNIVERSE_SITEMAP_URL=https://sarmaaya.pk/sitemap.xml

LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5100
# Express 'trust proxy' setting. 1 = trust one hop (correct for Render/any single
# reverse proxy, and harmless with no proxy at all, as in local Docker Compose).
TRUST_PROXY=1
# Hard ceiling (ms) on puppeteer.launch(). Prevents a hung Chromium launch
# (e.g. under-provisioned memory/CPU) from blocking the browser pool forever.
BROWSER_LAUNCH_TIMEOUT=20000

# ---- Frontend ----
# Host port the frontend is published on. The app's public URL is
# http://<host>:<FRONTEND_PORT>. Used by the base file and the production overlay
# (docker-compose.prod.yml); Vite's dev server uses it too.
FRONTEND_PORT=5100
# Baked into the static bundle at build time (Vite) — must be the URL the *browser*
# can reach, never a compose-internal hostname.
VITE_API_URL=http://localhost:4000/api/v1
