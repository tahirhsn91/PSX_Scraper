# Self-contained Dockerfile for the FREE deployment path: Express API + BullMQ
# workers + scheduler in ONE process/container (see backend/src/combined.ts for
# why). Use this instead of Dockerfile.api + Dockerfile.worker when deploying to
# a platform where a real background-worker service isn't free (e.g. Render —
# its free plan explicitly excludes background workers). Not used by
# docker-compose.yml, which keeps API and worker as separate containers.

# ---- Build stage ----
FROM node:20-bookworm-slim AS build
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium fonts-liberation libnss3 libatk-bridge2.0-0 libatk1.0-0 \
    libcups2 libdrm2 libgbm1 libasound2 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libxkbcommon0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

COPY backend/package.json ./backend/
COPY database ./database
WORKDIR /app/backend
RUN npm install
WORKDIR /app
COPY backend ./backend
WORKDIR /app/backend
RUN npx prisma generate --schema=../database/prisma/schema.prisma
RUN npm run build

# ---- Runtime (combined) ----
FROM node:20-bookworm-slim AS runtime
WORKDIR /app/backend
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium fonts-liberation libnss3 libatk-bridge2.0-0 libatk1.0-0 \
    libcups2 libdrm2 libgbm1 libasound2 libxcomposite1 libxdamage1 \
    libxfixes3 libxrandr2 libxkbcommon0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
COPY --from=build /app/backend/node_modules ./node_modules
COPY --from=build /app/backend/dist ./dist
COPY --from=build /app/backend/package.json ./package.json
COPY --from=build /app/database ../database
COPY backend/docker-entrypoint-combined.sh ./
RUN chmod +x docker-entrypoint-combined.sh \
    && groupadd -r app && useradd -r -g app -m -d /home/app app && chown -R app:app /app /home/app
# Chrome's crashpad crash-reporter needs a writable $HOME to create its crash
# database; without one it fails immediately on launch (see browserPool.ts).
ENV HOME=/home/app
USER app
EXPOSE 4000
CMD ["./docker-entrypoint-combined.sh"]
